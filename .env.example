# ---------------------------------------------------------------------------
# Portfolio environment
# Copy to .env.local (never commit it) and fill in what you need.
# ---------------------------------------------------------------------------

# Canonical URL used for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://my-website-pearl-gamma.vercel.app

# Contact form delivery (optional but recommended).
# 1. Create an API key at https://resend.com/api-keys
# 2. Verify your sending domain in Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=mritunjaisinghwork@gmail.com
# Must be a verified domain. The sandbox sender below only delivers to the
# email address that owns the Resend account.
CONTACT_FROM_EMAIL="Mritunjai Portfolio <onboarding@resend.dev>"
